# Testlər üçün AYRI baza. Dev bazanı istifadə etmə: testlər cədvəllərə yazıb silir.
# 1) Bazanı yarat:  createdb upra_test   (və ya pgAdmin ilə)
# 2) Bu faylı .env.test adı ilə kopyala və DATABASE_URL-i düzəlt
# 3) Cədvəlləri qur:  npx dotenv -e .env.test -- npx prisma migrate deploy
#    (dotenv-cli yoxdursa: PowerShell-də $env:DATABASE_URL="..." ; npx prisma migrate deploy)
NODE_ENV=test
DATABASE_URL="postgresql://user:password@localhost:5433/db_name?schema=public"
JWT_SECRET=test_secret_not_for_production
