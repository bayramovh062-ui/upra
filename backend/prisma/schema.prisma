generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= ENUMLAR =================

enum Role {
  CLIENT
  FREELANCER
  ADMIN // yalnız controlled bootstrap script ilə verilir (self-register qadağandır)
}

enum JobStatus {
  DRAFT // client hələ dərc etməyib, yalnız özü görür
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ContractStatus {
  PENDING_ACCEPTANCE // client təklifi qəbul edib, frilanserin razılığı gözlənilir
  ACTIVE
  DELIVERED // frilanser işi təhvil verib, client baxır (lövhə read-only)
  COMPLETED
  CANCELLED
  DECLINED // frilanser təklifi rədd edib; iş yenidən OPEN olur
}

enum IssueStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
}

enum PaymentStructure {
  MILESTONES
  LUMP_SUM
}

enum Availability {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

// Mərhələ (ödəniş mərhələsi + sprint).
// Real axın (2B): PENDING -> FUNDED -> IN_REVIEW -> PAID; IN_REVIEW -> FUNDED (dəyişiklik istə); ləğvdə -> CANCELLED.
// P2: FUNDED/IN_REVIEW -> DISPUTED (admin həll edir) -> PAID (RELEASE/SPLIT) və ya CANCELLED (REFUND).
// APPROVED enum-da qalır (geriyə uyğunluq), amma heç bir əməliyyat ona keçmir.
enum MilestoneStatus {
  PENDING // hələ maliyyələşdirilməyib
  FUNDED // client pulu escrow-a qoyub, iş gedir
  IN_REVIEW // frilanser təhvil verib, client baxır
  APPROVED // istifadə olunmur
  PAID // ödəniş tranzaksiyası yazılıb (təsdiq və ya dispute həlli)
  DISPUTED // mübahisə açıqdır; pul escrow-da qalır, admin həll edir
  CANCELLED // müqavilə ləğv olunub; maliyyələşmiş idisə pul geri qaytarılıb
}

// Mərhələ tarixçəsi: təhvil (SUBMITTED) və dəyişiklik tələbi (CHANGES_REQUESTED)
enum SubmissionType {
  SUBMITTED
  CHANGES_REQUESTED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum DisputeResolution {
  RELEASE
  REFUND
  SPLIT
}

enum ReportTargetType {
  USER
  CONTRACT
  MILESTONE
  JOB
  MESSAGE
}

enum ReportStatus {
  OPEN
  REVIEWED
  CLOSED
}

// Ledger yazısının növü (əməliyyat)
enum TransactionType {
  TOP_UP // pul kisəsinə (demo) pul əlavə edilməsi
  MILESTONE_FUNDING // client mərhələni maliyyələşdirir
  ESCROW_LOCK // vəsait escrow-da kilidlənir
  ESCROW_RELEASE // escrow-dakı vəsait buraxılır (ödəniş və ya geri qaytarma üçün)
  MILESTONE_PAYMENT // frilanserə mərhələ ödənişi
  COMMISSION // frilanserdən platforma komissiyası
  REFUND // clientə geri qaytarma
  WITHDRAWAL // pul kisəsindən (demo) çıxarış
}

// Yazının pul kisəsinin hansı balansına aid olduğu
enum WalletBalanceType {
  AVAILABLE
  LOCKED
}

enum TransactionDirection {
  CREDIT // balans artır
  DEBIT // balans azalır
}

// ================= MODELLƏR =================

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  fullName     String
  role         Role

  // Profil (hamısı optional)
  headline      String?
  bio           String?
  hourlyRate    Decimal?     @db.Decimal(10, 2)
  location      String?
  timezone      String?
  availability  Availability @default(AVAILABLE)
  avatarUrl     String?
  profilePublic Boolean      @default(true) // false: başqaları yalnız ad və rolu görür
  deletedAt     DateTime? // Soft delete: doludursa hesab silinib (bazadan silinmir)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Əlaqələr
  jobPosts              JobPost[]
  proposals             Proposal[]
  contractsAsClient     Contract[]     @relation("ClientContracts")
  contractsAsFreelancer Contract[]     @relation("FreelancerContracts")
  createdIssues         Issue[]        @relation("CreatedIssues")
  assignedIssues        Issue[]        @relation("AssignedIssues")
  comments              IssueComment[]
  skills                UserSkill[]
  savedJobs             SavedJob[]
  wallet                Wallet?
  notifications         Notification[]
  conversationsAsClient     Conversation[] @relation("ConversationClient")
  conversationsAsFreelancer Conversation[] @relation("ConversationFreelancer")
  messages                  Message[]

  // P2
  milestoneSubmissions MilestoneSubmission[]
  disputesOpened       Dispute[]           @relation("DisputesOpened")
  disputesResolved     Dispute[]           @relation("DisputesResolved")
  reportsCreated       Report[]            @relation("ReportsCreated")
  reportsReviewed      Report[]            @relation("ReportsReviewed")
}

model JobPost {
  id          String    @id @default(uuid())
  title       String
  description String
  budget      Decimal   @db.Decimal(12, 2)
  status      JobStatus @default(OPEN)

  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  experienceLevel  ExperienceLevel?
  paymentStructure PaymentStructure @default(MILESTONES)
  deadline         DateTime?

  clientId String
  client   User   @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals Proposal[]
  contracts Contract[]
  skills    JobSkill[]
  savedBy   SavedJob[]

  @@index([status])
  @@index([clientId])
  @@index([categoryId])
}

model Proposal {
  id          String         @id @default(uuid())
  coverLetter String
  bidAmount   Decimal        @db.Decimal(12, 2)
  status      ProposalStatus @default(PENDING)

  jobPostId String
  jobPost   JobPost @relation(fields: [jobPostId], references: [id])

  freelancerId String
  freelancer   User   @relation(fields: [freelancerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract?

  @@unique([jobPostId, freelancerId]) // Bir frilanser bir işə yalnız 1 təklif göndərə bilər
  @@index([freelancerId])
}

model Contract {
  id     String         @id @default(uuid())
  status ContractStatus @default(ACTIVE)

  jobPostId String
  jobPost   JobPost @relation(fields: [jobPostId], references: [id])

  proposalId String   @unique
  proposal   Proposal @relation(fields: [proposalId], references: [id])

  clientId String
  client   User   @relation("ClientContracts", fields: [clientId], references: [id])

  freelancerId String
  freelancer   User   @relation("FreelancerContracts", fields: [freelancerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ləğv təklifi: iş başlayanda müqaviləni tek başına ləğv etmək olmur, digər tərəf razı olmalıdır.
  // cancelRequestedById dolu = gözləyən təklif var (kimə aid olduğu burada). Ləğv olunandan sonra tarixçə üçün qalır.
  cancelRequestedById String?
  cancelRequestedAt   DateTime?
  cancelReason        String?

  // Frilanserin müqavilə şərtlərini qəbul/rədd etmə anı (PENDING_ACCEPTANCE → ACTIVE/DECLINED)
  freelancerAcceptedAt DateTime?
  freelancerDeclinedAt DateTime?

  board      Board? // 1 contract = 1 board
  milestones Milestone[]

  // P2
  submissions MilestoneSubmission[]
  disputes    Dispute[]

  @@index([clientId])
  @@index([freelancerId])
  @@index([jobPostId])
}

model Board {
  id    String @id @default(uuid())
  title String @default("Project Board")

  contractId String   @unique
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  issues Issue[]
}

model Issue {
  id          String        @id @default(uuid())
  title       String
  description String?
  status      IssueStatus   @default(TODO)
  priority    IssuePriority @default(MEDIUM)
  position    Float         @default(0) // Kanban sıralaması üçün (Float: iki kartın arasına orta dəyər qoymaq üçün)

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreatedIssues", fields: [createdById], references: [id])

  assigneeId String?
  assignee   User?   @relation("AssignedIssues", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Boşdursa issue backlog-dadır. Mərhələ silinsə issue backlog-a qayıdır
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments IssueComment[]

  @@index([boardId, status, position])
  @@index([assigneeId])
  @@index([milestoneId])
}

model IssueComment {
  id   String @id @default(uuid())
  body String

  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
}

// ================= TAKSONOMİYA VƏ SAXLANMIŞ İŞLƏR =================

model Category {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  jobs JobPost[]
}

// Bacarıq: hər ad bir dəfə saxlanılır (slug = kiçik hərflə, trim olunmuş)
model Skill {
  id   String @id @default(uuid())
  name String
  slug String @unique

  jobs  JobSkill[]
  users UserSkill[]
}

model JobSkill {
  jobPostId String
  jobPost   JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobPostId, skillId])
  @@index([skillId])
}

model UserSkill {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

model SavedJob {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobPostId String
  jobPost   JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, jobPostId])
  @@index([jobPostId])
}

// ================= ESCROW, MƏRHƏLƏLƏR VƏ PUL KİSƏSİ (Mərhələ 2A) =================
// Bütün məbləğlər USD sentlə tam ədəddir ($25.50 = 2550). Float istifadə olunmur.
// Maliyyə yazıları heç vaxt kaskadla silinmir (onDelete: Restrict).

// Mərhələ həm ödəniş mərhələsi, həm də iş məkanında sprintdir (ayrıca Sprint modeli yoxdur)
model Milestone {
  id String @id @default(uuid())

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  title       String
  description String?
  amountCents Int // > 0 (CHECK)
  sequence    Int // müqavilə daxilində 1, 2, 3... (deterministik sıra)
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)

  // P2: dəyişiklik tələbi limiti. revisionCount yalnız qəbul olunmuş tələbdə artır.
  maxRevisions  Int @default(2)
  revisionCount Int @default(0)

  fundedAt    DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  paidAt      DateTime?
  disputedAt  DateTime?

  // P2: dispute həllinin nəticəsi (SPLIT/RELEASE/REFUND). PAID mərhələdə gross-dan fərqlənə bilər.
  resolvedReleaseCents Int?
  resolvedRefundCents  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues       Issue[]
  transactions Transaction[]
  submissions  MilestoneSubmission[]
  disputes     Dispute[]

  @@unique([contractId, sequence])
  @@index([contractId, status])
}

// Hər istifadəçinin ən çox bir pul kisəsi var
model Wallet {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  availableCents Int    @default(0) // >= 0 (CHECK)
  lockedCents    Int    @default(0) // escrow-da kilidli, >= 0 (CHECK)
  currency       String @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

// Dəyişməz maliyyə jurnalı (ledger): yazılar yalnız əlavə olunur.
// Bir əməliyyatın bütün yazıları eyni "reference" dəyərini paylaşır (məs. ödəniş + komissiya).
model Transaction {
  id String @id @default(uuid())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)

  type        TransactionType
  direction   TransactionDirection
  balanceType WalletBalanceType    @default(AVAILABLE)
  amountCents Int // həmişə müsbət; işarəni direction verir (CHECK > 0)
  currency    String               @default("USD")
  description String?
  reference   String? // əlaqəli əməliyyatın identifikatoru
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([milestoneId])
  @@index([reference])
}

// ================= BİLDİRİŞLƏR (P1) =================
// Tətbiqdaxili bildiriş: DB-də saxlanılır (offline olan giriş edəndə görünür) və socket ilə anında göndərilir.
// type: sərbəst mətn (enum deyil), yeni hadisə üçün migrasiya lazım olmasın.
// link: frontend yolu (məs. /contracts/<id>?tab=escrow). readAt boşdursa oxunmayıb.
model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String
  title String
  body  String?
  link  String?
  data  Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ================= ÇAT (P1) =================
// Bir client və bir frilanser arasında YALNIZ BİR daimi söhbət. Müqavilə bitsə və ya yenisi açılsa da eyni söhbət davam edir.
// Söhbət yalnız aralarında təklif (Proposal) olan cüt üçün açılır (controller yoxlayır).
// Oxunmamış mesaj: digər tərəfin yazdığı və mənim *LastReadAt vaxtından sonrakı mesajlar.
// Cascade yalnız test təmizliyi və hesabın fiziki silinməsi üçündür: real hesablar soft-delete olunur,
// silinmiş hesabla söhbət oxunaqlı qalır, amma yeni mesaj yazmaq olmur.
model Conversation {
  id String @id @default(uuid())

  clientId String
  client   User   @relation("ConversationClient", fields: [clientId], references: [id], onDelete: Cascade)

  freelancerId String
  freelancer   User   @relation("ConversationFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)

  clientLastReadAt     DateTime?
  freelancerLastReadAt DateTime?
  lastMessageAt        DateTime? // boşdursa hələ mesaj yoxdur (siyahıda görünmür)

  createdAt DateTime @default(now())

  messages Message[]

  @@unique([clientId, freelancerId])
  @@index([clientId, lastMessageAt])
  @@index([freelancerId, lastMessageAt])
}

model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

// ================= P2: MƏRHƏLƏ TARİXÇƏSİ, MÜBAHİSƏ, ŞİKAYƏT =================

// Hər submit və qəbul olunmuş dəyişiklik tələbi üçün bir yazı. Fayl əlavələri P3-ə qalır.
model MilestoneSubmission {
  id String @id @default(uuid())

  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  type SubmissionType // SUBMITTED | CHANGES_REQUESTED

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  revisionNumber Int      @default(0) // hansı revision təhvil verilib / hansı tələb sayılır
  note           String?  // dəyişiklik səbəbi (optional)

  createdAt DateTime @default(now())

  @@index([milestoneId, createdAt])
  @@index([contractId, createdAt])
}

// Milestone mübahisəsi. Bir mərhələdə eyni anda yalnız BİR OPEN dispute ola bilər
// (migrasiyada partial unique index ilə də tətbiq olunur).
model Dispute {
  id String @id @default(uuid())

  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  openedById String
  openedBy   User   @relation("DisputesOpened", fields: [openedById], references: [id])

  reason  String
  details String?

  status     DisputeStatus      @default(OPEN)
  resolution DisputeResolution? // RESOLVED olanda mütləq

  // Həll olunmuş məbləğlər (sent). releaseToFreelancerCents + refundToClientCents = gross.
  releaseToFreelancerCents Int?
  refundToClientCents      Int?

  adminId  String?
  admin    User?   @relation("DisputesResolved", fields: [adminId], references: [id])
  adminNote String?

  openedAt   DateTime @default(now())
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
  @@index([milestoneId, status])
  @@index([contractId])
}

// İstifadəçi şikayəti. targetId polimorfikdir (targetType ilə birlikdə oxunur).
model Report {
  id String @id @default(uuid())

  reporterId String
  reporter   User   @relation("ReportsCreated", fields: [reporterId], references: [id])

  targetType ReportTargetType
  targetId   String

  reason  String
  details String?

  status ReportStatus @default(OPEN)

  adminId   String?
  admin     User?   @relation("ReportsReviewed", fields: [adminId], references: [id])
  adminNote String?

  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}
