generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= ENUMLAR =================

enum Role {
  CLIENT
  FREELANCER
}

enum JobStatus {
  DRAFT // client hələ dərc etməyib, yalnız özü görür
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ContractStatus {
  ACTIVE
  DELIVERED // frilanser işi təhvil verib, client baxır (lövhə read-only)
  COMPLETED
  CANCELLED
}

enum IssueStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
}

enum PaymentStructure {
  MILESTONES
  LUMP_SUM
}

enum Availability {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

// Mərhələ (ödəniş mərhələsi + sprint).
// Real axın (2B): PENDING -> FUNDED -> IN_REVIEW -> PAID; IN_REVIEW -> FUNDED (dəyişiklik istə); ləğvdə -> CANCELLED.
// APPROVED və DISPUTED enum-da qalır (geriyə uyğunluq), amma 2B-də heç bir əməliyyat onlara keçmir.
enum MilestoneStatus {
  PENDING // hələ maliyyələşdirilməyib
  FUNDED // client pulu escrow-a qoyub, iş gedir
  IN_REVIEW // frilanser təhvil verib, client baxır
  APPROVED // istifadə olunmur
  PAID // ödəniş tranzaksiyası yazılıb (təsdiq və ödəniş eyni addımdır)
  DISPUTED // istifadə olunmur (mübahisə həlli üçün admin lazımdır)
  CANCELLED // müqavilə ləğv olunub; maliyyələşmiş idisə pul geri qaytarılıb
}

// Ledger yazısının növü (əməliyyat)
enum TransactionType {
  TOP_UP // pul kisəsinə (demo) pul əlavə edilməsi
  MILESTONE_FUNDING // client mərhələni maliyyələşdirir
  ESCROW_LOCK // vəsait escrow-da kilidlənir
  ESCROW_RELEASE // escrow-dakı vəsait buraxılır (ödəniş və ya geri qaytarma üçün)
  MILESTONE_PAYMENT // frilanserə mərhələ ödənişi
  COMMISSION // frilanserdən platforma komissiyası
  REFUND // clientə geri qaytarma
  WITHDRAWAL // pul kisəsindən (demo) çıxarış
}

// Yazının pul kisəsinin hansı balansına aid olduğu
enum WalletBalanceType {
  AVAILABLE
  LOCKED
}

enum TransactionDirection {
  CREDIT // balans artır
  DEBIT // balans azalır
}

// ================= MODELLƏR =================

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  fullName     String
  role         Role

  // Profil (hamısı optional)
  headline      String?
  bio           String?
  hourlyRate    Decimal?     @db.Decimal(10, 2)
  location      String?
  timezone      String?
  availability  Availability @default(AVAILABLE)
  avatarUrl     String?
  profilePublic Boolean      @default(true) // false: başqaları yalnız ad və rolu görür
  deletedAt     DateTime? // Soft delete: doludursa hesab silinib (bazadan silinmir)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Əlaqələr
  jobPosts              JobPost[]
  proposals             Proposal[]
  contractsAsClient     Contract[]     @relation("ClientContracts")
  contractsAsFreelancer Contract[]     @relation("FreelancerContracts")
  createdIssues         Issue[]        @relation("CreatedIssues")
  assignedIssues        Issue[]        @relation("AssignedIssues")
  comments              IssueComment[]
  skills                UserSkill[]
  savedJobs             SavedJob[]
  wallet                Wallet?
}

model JobPost {
  id          String    @id @default(uuid())
  title       String
  description String
  budget      Decimal   @db.Decimal(12, 2)
  status      JobStatus @default(OPEN)

  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  experienceLevel  ExperienceLevel?
  paymentStructure PaymentStructure @default(MILESTONES)
  deadline         DateTime?

  clientId String
  client   User   @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals Proposal[]
  contracts Contract[]
  skills    JobSkill[]
  savedBy   SavedJob[]

  @@index([status])
  @@index([clientId])
  @@index([categoryId])
}

model Proposal {
  id          String         @id @default(uuid())
  coverLetter String
  bidAmount   Decimal        @db.Decimal(12, 2)
  status      ProposalStatus @default(PENDING)

  jobPostId String
  jobPost   JobPost @relation(fields: [jobPostId], references: [id])

  freelancerId String
  freelancer   User   @relation(fields: [freelancerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract?

  @@unique([jobPostId, freelancerId]) // Bir frilanser bir işə yalnız 1 təklif göndərə bilər
  @@index([freelancerId])
}

model Contract {
  id     String         @id @default(uuid())
  status ContractStatus @default(ACTIVE)

  jobPostId String
  jobPost   JobPost @relation(fields: [jobPostId], references: [id])

  proposalId String   @unique
  proposal   Proposal @relation(fields: [proposalId], references: [id])

  clientId String
  client   User   @relation("ClientContracts", fields: [clientId], references: [id])

  freelancerId String
  freelancer   User   @relation("FreelancerContracts", fields: [freelancerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ləğv təklifi: iş başlayanda müqaviləni tek başına ləğv etmək olmur, digər tərəf razı olmalıdır.
  // cancelRequestedById dolu = gözləyən təklif var (kimə aid olduğu burada). Ləğv olunandan sonra tarixçə üçün qalır.
  cancelRequestedById String?
  cancelRequestedAt   DateTime?
  cancelReason        String?

  board      Board? // 1 contract = 1 board
  milestones Milestone[]

  @@index([clientId])
  @@index([freelancerId])
  @@index([jobPostId])
}

model Board {
  id    String @id @default(uuid())
  title String @default("Project Board")

  contractId String   @unique
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  issues Issue[]
}

model Issue {
  id          String        @id @default(uuid())
  title       String
  description String?
  status      IssueStatus   @default(TODO)
  priority    IssuePriority @default(MEDIUM)
  position    Float         @default(0) // Kanban sıralaması üçün (Float: iki kartın arasına orta dəyər qoymaq üçün)

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreatedIssues", fields: [createdById], references: [id])

  assigneeId String?
  assignee   User?   @relation("AssignedIssues", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Boşdursa issue backlog-dadır. Mərhələ silinsə issue backlog-a qayıdır
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments IssueComment[]

  @@index([boardId, status, position])
  @@index([assigneeId])
  @@index([milestoneId])
}

model IssueComment {
  id   String @id @default(uuid())
  body String

  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
}

// ================= TAKSONOMİYA VƏ SAXLANMIŞ İŞLƏR =================

model Category {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  jobs JobPost[]
}

// Bacarıq: hər ad bir dəfə saxlanılır (slug = kiçik hərflə, trim olunmuş)
model Skill {
  id   String @id @default(uuid())
  name String
  slug String @unique

  jobs  JobSkill[]
  users UserSkill[]
}

model JobSkill {
  jobPostId String
  jobPost   JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobPostId, skillId])
  @@index([skillId])
}

model UserSkill {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

model SavedJob {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobPostId String
  jobPost   JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, jobPostId])
  @@index([jobPostId])
}

// ================= ESCROW, MƏRHƏLƏLƏR VƏ PUL KİSƏSİ (Mərhələ 2A) =================
// Bütün məbləğlər USD sentlə tam ədəddir ($25.50 = 2550). Float istifadə olunmur.
// Maliyyə yazıları heç vaxt kaskadla silinmir (onDelete: Restrict).

// Mərhələ həm ödəniş mərhələsi, həm də iş məkanında sprintdir (ayrıca Sprint modeli yoxdur)
model Milestone {
  id String @id @default(uuid())

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  title       String
  description String?
  amountCents Int // > 0 (CHECK)
  sequence    Int // müqavilə daxilində 1, 2, 3... (deterministik sıra)
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)

  fundedAt    DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  paidAt      DateTime?
  disputedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues       Issue[]
  transactions Transaction[]

  @@unique([contractId, sequence])
  @@index([contractId, status])
}

// Hər istifadəçinin ən çox bir pul kisəsi var
model Wallet {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  availableCents Int    @default(0) // >= 0 (CHECK)
  lockedCents    Int    @default(0) // escrow-da kilidli, >= 0 (CHECK)
  currency       String @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

// Dəyişməz maliyyə jurnalı (ledger): yazılar yalnız əlavə olunur.
// Bir əməliyyatın bütün yazıları eyni "reference" dəyərini paylaşır (məs. ödəniş + komissiya).
model Transaction {
  id String @id @default(uuid())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)

  type        TransactionType
  direction   TransactionDirection
  balanceType WalletBalanceType    @default(AVAILABLE)
  amountCents Int // həmişə müsbət; işarəni direction verir (CHECK > 0)
  currency    String               @default("USD")
  description String?
  reference   String? // əlaqəli əməliyyatın identifikatoru
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([milestoneId])
  @@index([reference])
}
