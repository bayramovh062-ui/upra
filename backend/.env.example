PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/upra_db?schema=public"
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=http://localhost:5173
# Reverse proxy arxasında IP-ni düzgün oxumaq üçün (rate limiter). Boş: production-da 1, qalanlarda false.
# Proxy hop sayı (1, 2) və ya etibarlı proxy ünvanları (loopback,10.0.0.0/8). "true" qadağandır.
TRUST_PROXY=

# Plan P3 (file uploads): Cloudinary (Render disk is ephemeral). If unset, backend falls back to local ./uploads (dev/test only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_PROVIDER=

# Plan P3 (file uploads): Cloudinary (Render disk is ephemeral). Local ./uploads used when unset in non-prod.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_PROVIDER=
