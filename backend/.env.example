# ---------------------------------------------------------------------------
# Upra backend environment variables (example only - never commit real secrets)
# ---------------------------------------------------------------------------

# --- Runtime ---
PORT=5000
NODE_ENV=development

# --- Database ---
# PostgreSQL connection string used by Prisma.
# Neon: use the POOLED connection string for the running API (host contains "-pooler"),
# and the DIRECT (non-pooled) connection string for migrations. Keep sslmode=require.
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/upra_db?schema=public"

# --- Authentication ---
# Required. Server refuses to start without it.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- HTTP / CORS ---
# Comma-separated list of allowed frontend origins (HTTP API + Socket.IO).
CLIENT_URL=http://localhost:5173
# Reverse proxy handling for rate limiting. Accepts a hop count (1, 2) or a trusted
# proxy list (loopback,10.0.0.0/8). Leave empty for the default: 1 in production, false otherwise.
TRUST_PROXY=

# --- File uploads ---
# "cloudinary" (required in production) or "local" (development/test only).
# Leave empty to auto-select: Cloudinary when all three credentials are set, otherwise local.
# Production startup fails if local storage would be used.
UPLOAD_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional local storage directory (development/test only). Default: backend/uploads.
UPLOAD_LOCAL_DIR=

# --- External cron / scheduled maintenance ---
# Shared secret for POST /api/internal/auto-approve. If empty, the endpoint returns 404.
# Configure the same value in the Render Cron Job that calls the endpoint.
CRON_SECRET=
# In-process hourly auto-approval scheduler. External cron is preferred in production;
# set to false when relying only on the cron job.
ENABLE_SCHEDULER=true

# --- Demo features ---
# Set to false to disable the demo wallet top-up endpoint.
DEMO_TOPUP_ENABLED=true

# --- Email ---
# Used for email verification and password reset. Providers (priority: Brevo > SMTP > Resend):
#
# 0) Brevo (HTTPS API) - RECOMMENDED for production on Render (free tier blocks SMTP ports).
#    Free: 300 emails/day, no domain needed. In Brevo: SMTP & API > API Keys, and verify your sender
#    address under Senders, Domains & Dedicated IPs. EMAIL_FROM must be that verified sender.
BREVO_API_KEY=
#
# 1) SMTP (e.g. Gmail + App Password): works locally; Render free tier blocks it. Takes priority over Resend.
#    Gmail: enable 2-step verification, then create an App Password at
#    https://myaccount.google.com/apppasswords (16 characters, spaces are ignored).
#    Install the dependency once: npm install nodemailer
#    Note: some hosts (e.g. Render free web services) block outbound SMTP ports; use Resend there.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
#
# 2) Resend (HTTPS API): production REQUIRES either SMTP_* or RESEND_API_KEY + EMAIL_FROM.
# Development: when RESEND_API_KEY is empty, emails are printed to the server log instead (copy the link from there).
# Note: with Resend's shared sender (onboarding@resend.dev) you can only email your own Resend account address.
# Verify a domain in Resend to email arbitrary users.
RESEND_API_KEY=
EMAIL_FROM="Upra <onboarding@resend.dev>"
# Public frontend URL used in email links. Falls back to the first CLIENT_URL.
APP_URL=http://localhost:5173
# Block unverified accounts from posting jobs / sending proposals.
# Leave empty for the default: true in production, false otherwise.
REQUIRE_EMAIL_VERIFICATION=
